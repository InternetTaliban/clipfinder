# Copy to .env. The app sends this as "Authorization: Bearer <token>".
CLIPFINDER_TOKEN=change-me-to-a-long-random-string
PORT=8787

# Optional: songs are recognized with Shazam (free, unofficial). With an AudD token (https://dashboard.audd.io),
# AudD (paid) is used as a fallback whenever Shazam fails.
AUDD_TOKEN=

# Optional: the Claude Code config folder the find-original agent uses, if it isn't the default ~/.claude
# (it must have last30days and the agent-reach skill installed and be logged in).
# CLAUDE_CONFIG_DIR=C:\Users\you\.claude-work
